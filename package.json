{
  "name": "@singseq/akasha-core",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "全息物理计算与知识条目",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts src/chart.ts src/data.ts src/holography.ts src/serializer.ts --format esm,cjs --dts --clean",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsup": "8.5.1"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weihaoyang/akasha-core.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chart": {
      "import": {
        "types": "./dist/chart.d.ts",
        "default": "./dist/chart.js"
      },
      "require": {
        "types": "./dist/chart.d.cts",
        "default": "./dist/chart.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./dist/data.d.ts",
        "default": "./dist/data.js"
      },
      "require": {
        "types": "./dist/data.d.cts",
        "default": "./dist/data.cjs"
      }
    },
    "./holography": {
      "import": {
        "types": "./dist/holography.d.ts",
        "default": "./dist/holography.js"
      },
      "require": {
        "types": "./dist/holography.d.cts",
        "default": "./dist/holography.cjs"
      }
    },
    "./serializer": {
      "import": {
        "types": "./dist/serializer.d.ts",
        "default": "./dist/serializer.js"
      },
      "require": {
        "types": "./dist/serializer.d.cts",
        "default": "./dist/serializer.cjs"
      }
    }
  }
}
